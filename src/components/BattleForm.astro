<form id="battle-form" class="battle-form" novalidate>
	<div class="player-input">
		<label for="player-one">Player 1</label>
		<input
			id="player-one"
			name="playerOne"
			type="text"
			placeholder="octocat"
			autocomplete="off"
			maxlength="39"
			required
		/>
	</div>
	<div class="player-input">
		<label for="player-two">Player 2</label>
		<input
			id="player-two"
			name="playerTwo"
			type="text"
			placeholder="torvalds"
			autocomplete="off"
			maxlength="39"
			required
		/>
	</div>
	<div class="quick-matchups" aria-label="Quick matchups">
		<span>Quick matchups:</span>
		<button class="preset-button" type="button" data-player-one="torvalds" data-player-two="gaearon">
			torvalds vs. gaearon
		</button>
		<button
			class="preset-button"
			type="button"
			data-player-one="octocat"
			data-player-two="sindresorhus"
		>
			octocat vs. sindresorhus
		</button>
	</div>
	<button class="battle-button" type="submit">BATTLE!</button>
</form>
